<?xml version="1.0" encoding="utf-8"?>
<!-- 电视端底部控件的"选中"样式（用户 2026-09-27：遥控器选中样式有问题，很难描述）。
     原来用的是 selectableItemBackgroundBorderless —— 在暗背景上只有一圈很淡的圆形涟漪，
     电视上一米外基本看不出来。这里给一个"实心填充 + 内侧描边"的方块，选中一眼可见。
     只在电视端用（代码里按 tv 判断设置），手机端保留原来的涟漪。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#573EA6FF" />
            <stroke android:width="2dp" android:color="#FF3EA6FF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#33FFFFFF" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
