<?xml version="1.0" encoding="utf-8"?>
<!-- loginRoot 是 FrameLayout：表单之上盖一层"启动遮罩"。
     为什么要遮罩：有会话 cookie 时先静默探活（/auth/me），这期间**不许露出登录信息**
     —— 用户 2026-09-24 报障："每次打开软件都会闪一下登录信息，要无感"。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/loginRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:id="@+id/loginScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/loginForm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="30sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/login_title"
                android:textColor="#FF9AA0A6"
                android:layout_marginBottom="22dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_server">

                <!-- 电视遥控器（用户 2026-09-25 报障："登录界面确认按钮无法获得焦点，无法操作登录"）：
                     焦点链必须**写死**（nextFocusDown/Forward），而且每个输入框都要有 imeOptions ——
                     电视的软键盘是遥控器驱动的，键盘上那颗"下一项/完成"键就是靠 imeOptions 决定存不存在；
                     不给 imeOptions，键盘上的确认键就是死的，输入完**没有路**能走到登录按钮。 -->
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/server"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textUri|textNoSuggestions"
                    android:imeOptions="actionNext"
                    android:nextFocusForward="@id/username"
                    android:nextFocusDown="@id/username"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/hint_username">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/username"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text|textNoSuggestions"
                    android:imeOptions="actionNext"
                    android:nextFocusForward="@id/password"
                    android:nextFocusDown="@id/password"
                    android:nextFocusUp="@id/server"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="@string/hint_password">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/password"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:imeOptions="actionDone"
                    android:nextFocusForward="@id/login"
                    android:nextFocusDown="@id/login"
                    android:nextFocusUp="@id/username"
                    android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/login"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:nextFocusUp="@id/password"
                android:nextFocusDown="@id/tls"
                android:text="@string/action_login" />

            <CheckBox
                android:id="@+id/tls"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:nextFocusUp="@id/login"
                android:nextFocusDown="@id/remember"
                android:text="@string/use_tls" />

            <CheckBox
                android:id="@+id/remember"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:nextFocusUp="@id/tls"
                android:nextFocusDown="@id/battery"
                android:text="@string/remember_me" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/battery"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:visibility="gone"
                android:nextFocusUp="@id/remember"
                android:text="@string/allow_background" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="#FFFFB4B4"
                android:textSize="13sp" />
        </LinearLayout>
    </ScrollView>

    <!-- 启动遮罩：只显示图标，不放任何登录信息（静默验证通过就直接进观看页） -->
    <LinearLayout
        android:id="@+id/splash"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@color/zv_splash_bg">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:contentDescription="@string/app_name"
            android:src="@drawable/ic_launcher_login" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/splash_entering"
            android:textColor="#FF9AA0A6"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
