<?xml version="1.0" encoding="utf-8"?>
<!-- 原生播放页：硬解播放 + 后台继续。控件交给 PlayerView（播放/暂停/上下条/进度/手势）。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:orientation="vertical">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:use_controller="true"
        app:show_buffering="when_playing"
        app:resize_mode="fit"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <!-- 互动栏：与网页图标栏同一批接口（收藏/喜欢/稍后再看），从列表点进来也能直接收藏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="4dp">

        <ImageButton
            android:id="@+id/fav"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="收藏"
            android:src="@drawable/ic_heart" />

        <ImageButton
            android:id="@+id/like"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="喜欢"
            android:src="@drawable/ic_thumb" />

        <ImageButton
            android:id="@+id/later"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="稍后再看"
            android:src="@drawable/ic_clock" />
    </LinearLayout>

    <TextView
        android:id="@+id/nowPlaying"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp"
        android:textColor="#FFEDEDED"
        android:textSize="14sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="12dp"
        android:text="锁屏/退到后台会继续播放，通知栏可以控制"
        android:textColor="#FF9AA0A6"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/stop"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:text="停止并退出" />
</LinearLayout>
