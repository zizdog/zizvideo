<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 后台"听视频"必须的：前台服务（mediaPlayback 类型）+ 通知 + 播放期间持锁 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- 用户上传：后台把视频传完（息屏不断），前台服务类型 dataSync（Android 14+ 要单独声明） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 后台听视频在国产 ROM 上常被杀：允许用户在系统弹窗里一次点掉（自用分发，不上架） -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- 自动检查更新：下载完的 APK 要通过系统安装器装上（用户 2026-09-25："不想再一次次手动下载安装"）。
         自用分发（不上架），这个权限是唯一能省掉"手动拷包再点安装"的路子；安装界面仍由用户确认。 -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- 电视端（用户 2026-09-25："同时开发电视端 app"）：同一个包装到 Android TV / 盒子上也能用。
         三个 required=false 是"兼容"的关键：电视没有触摸屏，也不能因为缺 leanback 就装不上手机。
         有了 leanback 特性 + 入口里的 LEANBACK_LAUNCHER + banner，电视桌面才会列出这个应用。 -->
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Zizvideo">

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- 电视桌面（Leanback）也列这个入口：遥控器点开就是同一套界面 -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- 快捷方式用自家 scheme 进来（zizvideo://listen/feed 等） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="zizvideo" />
            </intent-filter>
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- 原生播放页：ExoPlayer 硬解；退出页面后由 PlaybackService 继续放（后台/锁屏） -->
        <!-- B4：支持画中画（点播放页的小窗按钮 ⇒ 缩成浮窗继续放，可以边刷别的） -->
        <activity
            android:name=".PlayerActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:theme="@style/Theme.Zizvideo" />

        <!-- 前台服务 + MediaSession：通知栏/锁屏控制、后台不被回收 -->
        <service
            android:name=".PlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- 用户上传：SAF 选中的视频在后台传完（同一套分片接口），息屏/切后台都不停 -->
        <service
            android:name=".UploadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 网页界面宿主：复用现成 UI，配置变化自己扛（别因旋转重建丢播放状态） -->
        <!-- B4：也支持画中画（网页工具条的「画中画」按钮走 ZvAndroid.enterPip） -->
        <activity
            android:name=".WebActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode"
            android:exported="false"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:windowSoftInputMode="adjustResize" />

        <!-- 自动检查更新：把下载好的 APK 以 content:// 形式交给系统安装器
             （直接给 file:// 在安卓 7+ 会 FileUriExposedException，装不了） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
